{
  "name": "foldkit-ui-sdk-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "generate": "pnpm --filter foldkit-ui-sdk run generate",
    "check:generated": "pnpm --filter foldkit-ui-sdk run check:generated",
    "dev": "pnpm --filter poc run dev",
    "dev:showcase": "pnpm --filter showcase run dev",
    "dev:site": "pnpm --filter site run dev",
    "build": "pnpm -r run --if-present build",
    "screenshot": "node scripts/screenshot.mjs",
    "typecheck": "pnpm -r run --if-present typecheck",
    "test": "pnpm --filter foldkit-ui-sdk run test",
    "test:e2e": "playwright test",
    "check": "pnpm run check:generated && pnpm run typecheck && pnpm run test && pnpm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0"
  }
}
